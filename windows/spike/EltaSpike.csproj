<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinRT (Windows.Media.Ocr / Windows.Graphics.Imaging) 投影要求 TFM 带 Windows SDK 版本 -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>

    <!-- 产品栈是 WPF；同时开 WinForms 以复用 Screen / Clipboard / DataObject -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>

    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <AssemblyName>EltaSpike</AssemblyName>
    <RootNamespace>EltaSpike</RootNamespace>
    <StartupObject>EltaSpike.SpikeWindow</StartupObject>
  </PropertyGroup>

</Project>
