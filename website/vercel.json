{
  "name": "elta",
  "version": 2,
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/download/(.*)", "headers": { "cache-control": "public, max-age=3600" }, "dest": "/download/$1" }
  ],
  "cleanUrls": false,
  "trailingSlash": false
}
