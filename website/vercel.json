{
  "version": 2,
  "functions": {
    "api/admin.js": {
      "maxDuration": 10
    }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/download/(.*)", "headers": { "cache-control": "public, max-age=3600" }, "dest": "/download/$1" }
  ],
  "cleanUrls": false,
  "trailingSlash": false
}
